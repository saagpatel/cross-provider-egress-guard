 #!/usr/bin/env python3
 from __future__ import annotations
 
+import fnmatch
 import json
 import os
 import re
+import shlex
 import subprocess
 import time
+from dataclasses import dataclass
 from pathlib import Path
 from typing import Any
 
@@ -698,3 +701,681 @@ def sys_stdin_or_arg() -> str:
     if len(os.sys.argv) > 1:
         return os.sys.argv[1]
     return ""
+
+
+# ── Cross-Provider Egress Guard ─────────────────────────────────────────────
+# Destination-aware default-deny for network/send-class tools, mirroring the
+# Claude Code mcp-guard.sh Layer 2.5. Reads the SAME canonical allow-list
+# (~/.claude/mcp-gate-policy.json `.egress` block) so both agents enforce one
+# source of truth. Fail-closed: any failure to read/parse the policy denies
+# network-class commands/tools. See cross-provider-egress-guard/THREAT-MODEL-FREEZE.md.
+
+EGRESS_LOOPBACK_HOSTS = {"localhost", "127.0.0.1", "0.0.0.0", "::1", "[::1]"}
+EGRESS_SHELL_NET_RE = re.compile(
+    r"\b(curl|wget|scp|rsync|ncat|telnet|sftp|ftp|ssh)\b|(?<![A-Za-z0-9_])nc(?![A-Za-z0-9_])",
+    re.IGNORECASE,
+)
+# OpenSSH single-char options that consume the NEXT token as their value. Pinned
+# to the value-taking set so a mis-parse can only land on a flag value or the
+# remote command — both fail closed. Boolean flags are deliberately excluded:
+# misclassifying one as value-taking is the ONLY way to skip the real host.
+_SSH_VALUE_FLAGS = frozenset("BbcDEeFIiJLlmOopQRSWw")
+_EGRESS_PROXYJUMP_RE = re.compile(r"\s*proxyjump\s*=\s*(.+)", re.IGNORECASE)
+_EGRESS_SCHEME_URL_RE = re.compile(r"[a-z][a-z0-9+.-]*://[^/?#\"'\s]+", re.IGNORECASE)
+_EGRESS_SCP_HOST_RE = re.compile(r"@([A-Za-z0-9.\-]+):")
+_EGRESS_NC_HOST_RE = re.compile(
+    r"\b(?:nc|ncat|telnet)\b(?:\s+-\S+)*\s+([A-Za-z0-9.\-]+)\s+\d+", re.IGNORECASE
+)
+EGRESS_KILL_SWITCH_RE = re.compile(
+    r"\bCODEX_HOOKS_DISABLE(?:_[A-Z0-9]+)?\s*=\s*['\"]?1\b"
+    r"|(?:>>?|\b(?:tee|cp|mv|install|ln)\b)[^\n]*\bdisabled\.json\b",
+    re.IGNORECASE,
+)
+
+
+@dataclass(frozen=True)
+class EgressDecision:
+    decision: str  # "allow" | "deny"
+    reason: str | None = None
+    matched_host: str | None = None
+
+
+_EGRESS_ALLOW = EgressDecision("allow")
+
+
+def _egress_policy_path() -> Path:
+    # Env override mirrors mcp-guard.sh's MCP_GATE_POLICY (used by tests).
+    return Path(
+        os.environ.get(
+            "CODEX_EGRESS_POLICY", str(HOME / ".claude" / "mcp-gate-policy.json")
+        )
+    )
+
+
+def load_egress_policy() -> dict[str, Any] | None:
+    """Return the shared `.egress` block, or None (→ fail closed) if the policy is
+    absent, unreadable, invalid JSON, missing the egress block, or not default-deny."""
+    try:
+        data = json.loads(_egress_policy_path().read_text(encoding="utf-8"))
+    except Exception:
+        return None
+    egress = data.get("egress") if isinstance(data, dict) else None
+    if not isinstance(egress, dict) or egress.get("default") != "deny":
+        return None
+    return egress
+
+
+def _egress_payload_text(tool_input: object) -> str:
+    try:
+        return json.dumps(tool_input, sort_keys=True)
+    except Exception:
+        return str(tool_input)
+
+
+def _egress_server_segment(tool_name: str) -> str:
+    rest = tool_name[len("mcp__") :] if tool_name.startswith("mcp__") else tool_name
+    return rest.split("__", 1)[0]
+
+
+def _egress_tool_matches(tool_name: str, globs: list[str]) -> bool:
+    return any(fnmatch.fnmatchcase(tool_name, g) for g in globs)
+
+
+def _egress_normalize_host(raw: str) -> str:
+    h = re.sub(r"^[a-z][a-z0-9+.-]*://", "", raw, flags=re.IGNORECASE)  # scheme
+    h = re.sub(r"^.*@", "", h)  # userinfo (github.com@evil.tld → evil.tld)
+    if h.startswith("[") and "]" in h:  # IPv6 literal: [::1]:8080 → [::1]
+        h = h[: h.index("]") + 1]
+    else:
+        h = re.sub(r":.*$", "", h)  # port
+    return h.rstrip(".").lower()  # trailing dot
+
+
+def _egress_host_allowed(host: str, allow_hosts: list[str]) -> bool:
+    host = host.rstrip(".").lower()
+    if host in EGRESS_LOOPBACK_HOSTS:
+        return True  # loopback is not external egress
+    return any(fnmatch.fnmatch(host, g.lower()) for g in allow_hosts)
+
+
+def _egress_extract_hosts(text: str) -> list[str]:
+    hosts: set[str] = set()
+    for match in _EGRESS_SCHEME_URL_RE.findall(text):
+        hosts.add(_egress_normalize_host(match))
+    for match in _EGRESS_SCP_HOST_RE.findall(text):
+        hosts.add(match.rstrip(".").lower())
+    for match in _EGRESS_NC_HOST_RE.findall(text):
+        hosts.add(match.rstrip(".").lower())
+    return sorted(h for h in hosts if h)
+
+
+def _egress_proxy_jump_hosts(flag_char: str, value: str) -> list[str]:
+    """ProxyJump hosts (`-J` / `-o ProxyJump=`) are DIRECT local egress — the
+    client connects to each jump host before the target — so they must be
+    extracted, unlike -L/-R/-W forward targets (reached by the remote server,
+    R1-class). `-o ProxyCommand=` with a non-verb host stays an R3-class residual;
+    named verbs inside it (nc/curl/…) are still caught by the raw-string extractor."""
+    if flag_char == "J":
+        spec = value
+    elif flag_char == "o":
+        match = _EGRESS_PROXYJUMP_RE.match(value)
+        spec = match.group(1) if match else ""
+    else:
+        return []
+    return [h for h in (_egress_normalize_host(p) for p in spec.split(",")) if h]
+
+
+def _egress_ssh_hosts(command: str) -> list[str]:
+    """Extract ssh destination hosts from `ssh [-flags] [user@]host [cmd ...]`.
+
+    Flag-aware: option flags (and the value tokens of value-taking flags) are
+    skipped, so the first BARE token after `ssh` — ssh's own destination rule —
+    is the host. ProxyJump (`-J` / `-o ProxyJump=`) hosts are extracted too (direct
+    local egress). `ssh://` URIs are handled by the URL extractor, not here. A
+    mis-parse lands on a flag value or the remote command (non-allowlisted → deny)
+    or yields no host (→ fail-closed deny). git-over-ssh (`git push`,
+    `git clone git@host:...`) carries no literal `ssh` token and is untouched.
+    """
+    try:
+        lexer = shlex.shlex(command, posix=True, punctuation_chars=True)
+        lexer.whitespace_split = True
+        lexer.commenters = ""
+        tokens = list(lexer)
+    except ValueError:
+        return []  # malformed quoting → fail closed (caller is in the net branch)
+
+    def _is_separator(tok: str) -> bool:
+        return bool(tok) and all(ch in ";&|()<>" for ch in tok)
+
+    hosts: set[str] = set()
+    i, n = 0, len(tokens)
+    while i < n:
+        if tokens[i].lower() != "ssh":
+            i += 1
+            continue
+        j, host = i + 1, None
+        while j < n:
+            tok = tokens[j]
+            if _is_separator(tok):
+                break
+            if tok == "--":  # end-of-options: the next token is the destination
+                if j + 1 < n and not _is_separator(tokens[j + 1]):
+                    host = tokens[j + 1]
+                break
+            if tok.startswith("-") and len(tok) > 1:  # option flag (cluster)
+                body = tok[1:]
+                for k, ch in enumerate(body):
+                    if ch in _SSH_VALUE_FLAGS:
+                        if k + 1 < len(body):  # value bundled in this token (-Jhost)
+                            value = body[k + 1 :]
+                        elif j + 1 < n:  # value is the next token
+                            j += 1
+                            value = tokens[j]
+                        else:
+                            value = ""
+                        hosts.update(_egress_proxy_jump_hosts(ch, value))
+                        break
+                j += 1
+                continue
+            host = tok  # first bare token = ssh destination
+            break
+        if host:
+            hosts.add(_egress_normalize_host(host))
+        i = j + 1
+    return sorted(h for h in hosts if h)
+
+
+_GG_SEP = frozenset({";", "&&", "||", "|", "&", "(", ")"})
+_GG_PREFIX = frozenset(
+    {"env", "time", "sudo", "nohup", "nice", "command", "builtin", "exec",
+     "xargs", "then", "do", "else"}
+)
+_GG_GIT_VALUE_FLAGS = frozenset(
+    {"-C", "-c", "--git-dir", "--work-tree", "--namespace", "--exec-path"}
+)
+_GG_GH_READ_SUBS = frozenset(
+    {"search", "browse", "status", "auth", "config", "alias", "extension",
+     "help", "version", "completion"}
+)
+_GG_GH_READ_VERBS = frozenset(
+    {"view", "list", "clone", "status", "diff", "checkout", "download",
+     "browse", "search", "ls", "get", "cat", "read", "show"}
+)
+_GG_ENV_RE = re.compile(r"[A-Za-z_][A-Za-z0-9_]*=")
+_EGRESS_GIT_GH_RE = re.compile(r"\b(git|gh)\b", re.IGNORECASE)
+_GG_API_WRITE_RE = re.compile(
+    r"(-X|--method)[ =]*(POST|PUT|PATCH|DELETE)|--field|--raw-field|--input|\s-[fF]",
+    re.IGNORECASE,
+)
+
+
+def _gg_tokenize(command: str) -> list[str]:
+    """Quote-aware tokens, shell operators preserved as their own tokens (mirrors
+    gg_tokenize in bash-egress-guard.sh). shlex only -> no execution. A quoted
+    commit message collapses to ONE arg token, so it is never mistaken for a
+    command word (the false-positive guard)."""
+    lexer = shlex.shlex(command, posix=True, punctuation_chars=True)
+    lexer.whitespace_split = True
+    try:
+        return list(lexer)
+    except ValueError:
+        return command.split()
+
+
+def _gg_url_owner(token: str) -> str | None:
+    match = _EGRESS_GH_OWNER_RE.search(token)
+    return match.group(1).lower() if match else None
+
+
+def _gg_ownerrepo_owner(spec: str) -> str | None:
+    owner = _gg_url_owner(spec)
+    if owner is not None:
+        return owner
+    rest = spec[1:] if spec.startswith("/") else spec
+    if rest.startswith("repos/"):
+        rest = rest[len("repos/"):]
+    head = rest.split("/", 1)[0]
+    if not head or head.startswith("-"):
+        return None
+    return head.lower()
+
+
+def _gg_is_dest_url(token: str) -> bool:
+    """True if token carries an explicit destination host (scheme URL or
+    user@host:scp-form). Distinguishes a remote/URL from a refspec/branch, so
+    HEAD:main / v1.0:main are never mistaken for an scp-form host."""
+    if "://" in token:
+        return True
+    parts = token.split("@", 1)
+    return len(parts) == 2 and ":" in parts[1]
+
+
+def _gg_dest_host(token: str) -> str | None:
+    """R13 — normalized destination host of a git write URL/scp-spec, or None if no
+    host is determinable. Reuses _egress_normalize_host so userinfo, a trailing FQDN
+    dot, and ports resolve to the TRUE host; deceptive forms (homoglyph, host-suffix,
+    IP-literal, punycode) land on their real host and fail the github_shell_hosts
+    allow-list."""
+    match = re.match(r"[a-z][a-z0-9+.-]*://([^/?#]+)", token, re.IGNORECASE)
+    if match:
+        return _egress_normalize_host(match.group(1)) or None
+    if _gg_is_dest_url(token):  # user@host:scp-form
+        before = token.split("@", 1)[1].split(":", 1)[0]
+        return _egress_normalize_host(before) or None
+    return None
+
+
+def _gg_resolve_remote(remote: str) -> tuple[str | None, str | None]:
+    """Best-effort: resolve a bare git remote to its (owner, host) via the process
+    cwd's git config. Unresolvable -> (None, None) (passes, R3-class). Codex uses the
+    process cwd (vs CC's hook-payload cwd), so resolution here is best-effort."""
+    try:
+        result = subprocess.run(
+            ["git", "remote", "get-url", remote],
+            capture_output=True,
+            text=True,
+            timeout=2,
+            check=False,
+        )
+    except Exception:
+        return None, None
+    if result.returncode != 0:
+        return None, None
+    url = result.stdout.strip()
+    return _gg_url_owner(url), _gg_dest_host(url)
+
+
+def _gg_scan_git(tokens: list[str], start: int) -> tuple[set[str], set[str]]:
+    """WRITE-class git destinations only: push (exfil-out) and remote add/set-url.
+    Returns (owners, hosts) — owners for R12 owner-scope, hosts for R13 write-host
+    allow-list. Reads emit nothing. Host is positional for push (the destination arg),
+    so refspecs (HEAD:main, v1.0:main) are never mistaken for an scp-form host."""
+    owners: set[str] = set()
+    hosts: set[str] = set()
+    n = len(tokens)
+    j = start + 1
+    sub = ""
+    while j < n:
+        token = tokens[j]
+        if token in _GG_SEP:
+            return owners, hosts
+        if token in _GG_GIT_VALUE_FLAGS:
+            j += 2
+            continue
+        if token.startswith("-"):
+            j += 1
+            continue
+        sub = token
+        j += 1
+        break
+    if sub not in {"push", "remote"}:
+        return owners, hosts
+    args: list[str] = []
+    while j < n and tokens[j] not in _GG_SEP:
+        args.append(tokens[j])
+        j += 1
+    for arg in args:  # owners (R12) from explicit github URLs in any arg
+        owner = _gg_url_owner(arg)
+        if owner is not None:
+            owners.add(owner)
+    if sub == "push":
+        dest = ""
+        for arg in args:  # destination = first non-flag arg; rest are refspecs
+            if not arg.startswith("-"):
+                dest = arg
+                break
+        if not dest:
+            dest = "origin"
+        if _gg_is_dest_url(dest):
+            host = _gg_dest_host(dest)
+            if host:
+                hosts.add(host)
+        else:  # bare remote -> resolve via cwd config (R3-class if unresolvable)
+            owner, host = _gg_resolve_remote(dest)
+            if owner:
+                owners.add(owner)
+            if host:
+                hosts.add(host)
+    elif args and args[0] in {"add", "set-url"}:  # remote add/set-url destination URLs
+        for arg in args:
+            if _gg_is_dest_url(arg):
+                host = _gg_dest_host(arg)
+                if host:
+                    hosts.add(host)
+    return owners, hosts
+
+
+def _gg_gh_api_is_write(args: list[str]) -> bool:
+    return _GG_API_WRITE_RE.search(" " + " ".join(args) + " ") is not None
+
+
+def _gg_scan_gh(tokens: list[str], start: int) -> tuple[set[str], set[str]]:
+    """WRITE-class gh targets only. Returns (owners, hosts). Reads emit nothing.
+    Unknown verbs default to write (fail-closed). gh's default backend is covered by
+    R12 owner-scope; only an explicit --hostname enterprise host is host-gated (NOT -H,
+    which is --head/--header on gh subcommands, never a hostname)."""
+    owners: set[str] = set()
+    hosts: set[str] = set()
+    n = len(tokens)
+    j = start + 1
+    sub = ""
+    while j < n:
+        token = tokens[j]
+        if token in _GG_SEP:
+            return owners, hosts
+        if token.startswith("-"):
+            j += 1
+            continue
+        sub = token
+        j += 1
+        break
+    if not sub:
+        return owners, hosts
+    args: list[str] = []
+    while j < n and tokens[j] not in _GG_SEP:
+        args.append(tokens[j])
+        j += 1
+    if sub in _GG_GH_READ_SUBS:
+        is_write = False
+    elif sub == "api":
+        is_write = _gg_gh_api_is_write(args)
+    else:
+        verb = ""
+        for arg in args:
+            if not arg.startswith("-"):
+                verb = arg
+                break
+        is_write = verb not in _GG_GH_READ_VERBS
+    if not is_write:
+        return owners, hosts
+    ghhost = ""
+    hidx = 0
+    hcount = len(args)
+    while hidx < hcount:
+        harg = args[hidx]
+        if harg == "--hostname":
+            hidx += 1
+            if hidx < hcount:
+                ghhost = args[hidx].lower()
+        elif harg.startswith("--hostname="):
+            ghhost = harg[len("--hostname="):].lower()
+        hidx += 1
+    if ghhost:
+        hosts.add(ghhost)
+    index = 0
+    count = len(args)
+    while index < count:
+        arg = args[index]
+        owner: str | None = None
+        if arg in {"--repo", "-R"}:
+            index += 1
+            if index < count:
+                owner = _gg_ownerrepo_owner(args[index])
+        elif arg.startswith("--repo="):
+            owner = _gg_ownerrepo_owner(arg[len("--repo="):])
+        elif arg.startswith("repos/") or arg.startswith("/repos/"):
+            owner = _gg_ownerrepo_owner(arg)
+        elif arg.startswith("-"):
+            owner = None
+        else:
+            owner = _gg_url_owner(arg)
+            # R14: a bare owner/repo positional is a write TARGET only in
+            # `gh repo <verb> owner/repo` (sub == "repo") -- the sole gh form taking
+            # one. Every other gh write names its owner via --repo/-R/repos-path/URL
+            # (handled above), so a slash here is a flag VALUE (title/body/header/
+            # branch), never a target. Scoping to sub == "repo" still gates ALL slash
+            # positionals in a repo write (incl. after a boolean/value flag) -> no bypass.
+            if owner is None and sub == "repo" and "/" in arg:
+                owner = _gg_ownerrepo_owner(arg)
+        if owner is not None:
+            owners.add(owner)
+        index += 1
+    return owners, hosts
+
+
+def _egress_git_gh_targets(command: str) -> tuple[set[str], set[str]]:
+    """WRITE-class git/gh targets in a shell command: (owners, hosts). Owners feed R12
+    owner-scope; hosts feed R13 write-host allow-list. Non-write/non-egress
+    subcommands are never scanned (a GitHub URL in a commit message is ignored).
+    Mirrors gg_github_targets in bash-egress-guard.sh."""
+    tokens = _gg_tokenize(command)
+    owners: set[str] = set()
+    hosts: set[str] = set()
+    n = len(tokens)
+    i = 0
+    cmd_pos = True
+    while i < n:
+        token = tokens[i]
+        if token in _GG_SEP:
+            cmd_pos = True
+            i += 1
+            continue
+        if cmd_pos:
+            if _GG_ENV_RE.match(token) or token in _GG_PREFIX:
+                i += 1
+                continue
+            cmd_pos = False
+            base = token.rsplit("/", 1)[-1]
+            if base == "git":
+                scan_owners, scan_hosts = _gg_scan_git(tokens, i)
+                owners |= scan_owners
+                hosts |= scan_hosts
+            elif base == "gh":
+                scan_owners, scan_hosts = _gg_scan_gh(tokens, i)
+                owners |= scan_owners
+                hosts |= scan_hosts
+        i += 1
+    return owners, hosts
+
+
+def _egress_git_gh_owners(command: str) -> set[str]:
+    """Back-compat shim: WRITE-class git/gh owners only (R12)."""
+    return _egress_git_gh_targets(command)[0]
+
+
+def _egress_github_shell_violation(
+    command: str, policy: dict[str, Any]
+) -> EgressDecision | None:
+    """R12 + R13 — deny a WRITE-class git/gh op to an owner not on github_shell_owners
+    (R12) or a destination host not on github_shell_hosts (R13). Each gate fires only
+    when its key is present. Undeterminable owner/host -> passes (R3-class)."""
+    owners, hosts = _egress_git_gh_targets(command)
+    allow_hosts = policy.get("github_shell_hosts")
+    if isinstance(allow_hosts, list):  # R13 armed
+        allowed_hosts = {str(h).lower() for h in allow_hosts}
+        for host in sorted(hosts):
+            if host in EGRESS_LOOPBACK_HOSTS:
+                continue
+            if host not in allowed_hosts:
+                return EgressDecision(
+                    "deny",
+                    f"git/gh write targets host '{host}', not on github_shell_hosts. "
+                    "Use an allow-listed host or widen the policy.",
+                    matched_host=host,
+                )
+    if "github_shell_owners" in policy:  # R12 armed
+        allowed = {str(owner).lower() for owner in (policy.get("github_shell_owners") or [])}
+        for owner in sorted(owners):
+            if owner not in allowed:
+                return EgressDecision(
+                    "deny",
+                    f"git/gh write targets GitHub owner '{owner}', not on "
+                    "github_shell_owners. Use an allow-listed owner or widen the policy.",
+                    matched_host=owner,
+                )
+    return None
+
+
+def egress_shell_decision(command: str | None) -> EgressDecision:
+    """Shell egress gate. R12 git/gh GitHub owner-scope (writes-only) runs first
+    (git/gh are not network verbs, so the network gate would skip them); then Mode 1
+    host allow-listing for network verbs (curl/wget/scp/rsync/nc/ssh/...). Fail-closed
+    for network verbs; the git/gh owner-scope is additive/opt-in (armed only when
+    github_shell_owners is present in the policy)."""
+    if not command:
+        return _EGRESS_ALLOW
+    is_net = bool(EGRESS_SHELL_NET_RE.search(command))
+    has_git_gh = bool(_EGRESS_GIT_GH_RE.search(command))
+    if not is_net and not has_git_gh:
+        return _EGRESS_ALLOW
+    policy = load_egress_policy()
+    if has_git_gh and policy is not None and (
+        "github_shell_owners" in policy or "github_shell_hosts" in policy
+    ):
+        violation = _egress_github_shell_violation(command, policy)
+        if violation is not None:
+            return violation
+    if not is_net:
+        return _EGRESS_ALLOW
+    if policy is None:
+        return EgressDecision(
+            "deny",
+            "egress policy unavailable; refusing network shell command (fail-closed).",
+        )
+    allow_hosts = policy.get("allow_hosts") or []
+    hosts = sorted(set(_egress_extract_hosts(command)) | set(_egress_ssh_hosts(command)))
+    if not hosts:
+        return EgressDecision(
+            "deny",
+            "network shell command with no verifiable destination host (fail-closed).",
+        )
+    for host in hosts:
+        if not _egress_host_allowed(host, allow_hosts):
+            return EgressDecision(
+                "deny",
+                f"egress to non-allowlisted host '{host}' blocked. Add it to "
+                "egress.allow_hosts in the shared policy or use an allowed destination.",
+                matched_host=host,
+            )
+    return _EGRESS_ALLOW
+
+
+_EGRESS_GH_OWNER_RE = re.compile(r"github\.com\.?[/:]+([A-Za-z0-9_.%\-]+)", re.IGNORECASE)
+
+
+def _egress_payload_owners(tool_input: object) -> set[str]:
+    """R6 — candidate resource owners in a connector payload (lowercased). Reads
+    owner/org/organization/repoOwner (string or {login}), the owner part of
+    repository/full_name/repository_full_name "owner/repo", and the owner
+    segment of a GitHub URL."""
+    owners: set[str] = set()
+    if isinstance(tool_input, dict):
+        owner = tool_input.get("owner")
+        if isinstance(owner, dict):
+            owner = owner.get("login")
+        if isinstance(owner, str):
+            owners.add(owner)
+        for key in ("org", "organization", "repoOwner", "repo_owner"):
+            value = tool_input.get(key)
+            if isinstance(value, str):
+                owners.add(value)
+        for key in ("repository", "full_name", "repository_full_name"):
+            value = tool_input.get(key)
+            if isinstance(value, str) and "/" in value:
+                owners.add(value.split("/", 1)[0])
+    for match in _EGRESS_GH_OWNER_RE.findall(_egress_payload_text(tool_input)):
+        owners.add(match)
+    return {o.lower() for o in owners if o}
+
+
+def _egress_owner_scope_violation(
+    tool_name: str, tool_input: object, policy: dict[str, Any]
+) -> EgressDecision | None:
+    """R6 — if tool_name matches a connector_owner_scope glob, every owner
+    positively identified in the payload must be allow-listed. A call with no
+    detectable owner passes (the remaining R6 surface, same class as R3)."""
+    scope = policy.get("connector_owner_scope")
+    if not isinstance(scope, dict):
+        return None
+    owners: set[str] | None = None
+    for glob, allowed in scope.items():
+        if not fnmatch.fnmatchcase(tool_name, glob):
+            continue
+        if owners is None:
+            owners = _egress_payload_owners(tool_input)
+        allow_lower = {str(a).lower() for a in (allowed or [])}
+        for owner in sorted(owners):
+            if owner not in allow_lower:
+                return EgressDecision(
+                    "deny",
+                    f"connector {tool_name} targets owner '{owner}', not on the "
+                    f"connector_owner_scope allow-list for '{glob}'. Fail-closed.",
+                    matched_host=owner,
+                )
+    return None
+
+
+def egress_tool_decision(tool_name: str, tool_input: object) -> EgressDecision:
+    """Modes 1/2/3 for MCP tools, mirroring mcp-guard.sh Layer 2.5. Closes the
+    ungated `mcp__codex_apps__*` connector path. Fail-closed."""
+    if not tool_name.startswith("mcp__"):
+        return _EGRESS_ALLOW
+    policy = load_egress_policy()
+    if policy is None:
+        # Fail closed: deny known connector namespaces (always egress) and
+        # conservative net-name tools when the policy cannot be read/classified.
+        if (
+            tool_name.startswith("mcp__codex_apps__")
+            or tool_name.startswith("mcp__claude_ai_")
+            or re.search(
+                r"(fetch|http|send|upload|webhook|browser_navigate)",
+                tool_name,
+                re.IGNORECASE,
+            )
+        ):
+            return EgressDecision(
+                "deny",
+                "egress policy unavailable; refusing network-class MCP tool (fail-closed).",
+            )
+        return _EGRESS_ALLOW
+
+    # Mode 1 — URL tools (first, so ctx_fetch_and_index beats the non-egress bypass).
+    if _egress_tool_matches(tool_name, policy.get("url_tools") or []):
+        allow_hosts = policy.get("allow_hosts") or []
+        hosts = _egress_extract_hosts(_egress_payload_text(tool_input))
+        if not hosts:
+            return EgressDecision(
+                "deny",
+                f"{tool_name} is a URL-class tool but no destination host could be "
+                "extracted from its input (fail-closed).",
+            )
+        for host in hosts:
+            if not _egress_host_allowed(host, allow_hosts):
+                return EgressDecision(
+                    "deny",
+                    f"{tool_name} targets non-allowlisted host '{host}'.",
+                    matched_host=host,
+                )
+        return _EGRESS_ALLOW
+
+    # Non-egress local servers (exact server segment) bypass the gate.
+    # Treat hyphen/underscore as spelling aliases for server ids because MCP
+    # server names appear in both forms across config and tool names.
+    server_segment = _egress_server_segment(tool_name)
+    server_alias = server_segment.replace("-", "_")
+    non_egress_aliases = {
+        str(s).replace("-", "_") for s in (policy.get("non_egress_servers") or [])
+    }
+    if server_segment in (policy.get("non_egress_servers") or []) or server_alias in non_egress_aliases:
+        return _EGRESS_ALLOW
+
+    # Mode 2 — fixed-backend connectors: must match an allow_connectors glob.
+    if _egress_tool_matches(tool_name, policy.get("connector_tools") or []):
+        if not _egress_tool_matches(tool_name, policy.get("allow_connectors") or []):
+            return EgressDecision(
+                "deny",
+                f"connector {tool_name} is not on the egress allow_connectors list "
+                "(unknown/renamed connector). Fail-closed.",
+            )
+        owner_violation = _egress_owner_scope_violation(tool_name, tool_input, policy)
+        if owner_violation is not None:
+            return owner_violation
+        return _EGRESS_ALLOW
+
+    # Mode 3 — generic network-name catch-all.
+    if _egress_tool_matches(tool_name, policy.get("network_name_globs") or []):
+        return EgressDecision(
+            "deny",
+            f"{tool_name} matches a network/send-class name but its destination cannot "
+            "be verified (Mode 3 fail-closed catch-all).",
+        )
+
+    return _EGRESS_ALLOW
+
+
+def command_disables_hooks(command: str | None) -> bool:
+    """Seam C — detect attempts to disable the Codex hook layer (kill-switch)."""
+    return bool(command and EGRESS_KILL_SWITCH_RE.search(command))
